.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #f0f0f0;
}

.hero-faction {
  color: #c9a24b;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.hero-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8a8aa0;
  margin-bottom: 16rpx;
}

/* 稀有度一览（2×2，与费用曲线框同宽） */
.rarity-grid {
  display: flex;
  flex-wrap: wrap;
}

.rarity-cell {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
}

/* 万能牌宝石图标（CSS 绘制，不依赖外部图片） */
.wildcard-gem {
  width: 34rpx;
  height: 34rpx;
  transform: rotate(45deg);
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: inset 0 0 10rpx rgba(255, 255, 255, 0.28);
}

.wildcard-gem.std {
  background: #9e9ea0;
}

.wildcard-gem.ltd {
  background: #f0e08a;
}

.wildcard-gem.spc {
  background: #c8c8d0;
}

.wildcard-gem.elt {
  background: #d4a017;
}

.rarity-text {
  font-size: 26rpx;
}

.rarity-text.std {
  color: #9e9ea0;
}

.rarity-text.ltd {
  color: #f0e08a;
}

.rarity-text.spc {
  color: #c8c8d0;
}

.rarity-text.elt {
  color: #d4a017;
}

.curve {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 140rpx;
}

.curve-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.curve-bar {
  width: 60%;
  min-height: 4rpx;
  background: #c9a24b;
  border-radius: 4rpx 4rpx 0 0;
}

.curve-label {
  font-size: 18rpx;
  color: #8a8aa0;
  margin-top: 4rpx;
}

.curve-count {
  font-size: 18rpx;
  color: #b8b8cc;
}

.card-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #26263c;
}

.card-row:last-child {
  border-bottom: none;
}

.card-img {
  width: 64rpx;
  height: 88rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.card-img-placeholder {
  background: #2c2c46;
}

.card-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 28rpx;
  color: #e6e6e6;
}

.card-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.card-count {
  color: #c9a24b;
  font-size: 28rpx;
  font-weight: 600;
}

/* 复制/编辑：一行等宽，放在稀有度一览下方 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-actions button {
  flex: 1;
  margin: 0;
}

/* 删除：底部居中，适中宽度 */
.delete-wrap {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.delete-btn {
  width: 45%;
}

.btn-danger {
  background: #3a1f24;
  color: #e06c6c;
  border-radius: 12rpx;
  border: 1rpx solid #6c3a3a;
}
